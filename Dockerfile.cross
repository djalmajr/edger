# Cross-build para linux/amd64 a partir de um host arm64 (ex.: Mac Apple
# Silicon publicando para um cluster x86). O Dockerfile canônico emula a
# plataforma-alvo inteira, e as duas toolchains quebram sob emulação: o bun
# x86_64 exige AVX2 (SIGILL) e o rustc x86_64 segfaulta sob Rosetta. Aqui os
# DOIS estágios de build rodam nativos na plataforma do builder e só o
# runtime é da plataforma-alvo — o Rust cross-compila com o gcc cross como
# linker (aws-lc-sys e ring compilam C, daí o cmake e o CC cross).
#
#   docker buildx build --platform linux/amd64 -f Dockerfile.cross ...
#
# Mantenha os estágios espelhando o Dockerfile canônico ao mudar qualquer um.

FROM --platform=$BUILDPLATFORM rust:1.98-bookworm AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
      gcc-x86-64-linux-gnu g++-x86-64-linux-gnu libc6-dev-amd64-cross cmake \
    && rm -rf /var/lib/apt/lists/* \
    && rustup target add x86_64-unknown-linux-gnu

ENV CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_LINKER=x86_64-linux-gnu-gcc \
    CC_x86_64_unknown_linux_gnu=x86_64-linux-gnu-gcc \
    CXX_x86_64_unknown_linux_gnu=x86_64-linux-gnu-g++ \
    AR_x86_64_unknown_linux_gnu=x86_64-linux-gnu-ar

WORKDIR /src
COPY . .
RUN cargo build --release -p edger-orchestrator --bin edger --features otel \
      --target x86_64-unknown-linux-gnu \
    && cp target/x86_64-unknown-linux-gnu/release/edger /usr/local/bin/edger

FROM --platform=$BUILDPLATFORM oven/bun:1.3.14 AS frontend-builder

WORKDIR /src/workers
COPY workers/package.json workers/bun.lock ./
COPY workers/ui ./ui
COPY workers/core/cpanel ./core/cpanel
COPY workers/core/webide ./core/webide
RUN bun install --frozen-lockfile && bun run build

FROM denoland/deno:debian

LABEL org.opencontainers.image.source="https://github.com/djalmajr/edger" \
      org.opencontainers.image.licenses="O'Saasy-1.0"

USER root
WORKDIR /app

COPY --from=builder /usr/local/bin/edger /usr/local/bin/edger
COPY workers/core/cpanel/manifest.yaml /opt/edger/core-workers/cpanel/manifest.yaml
COPY --from=frontend-builder /src/workers/core/cpanel/dist /opt/edger/core-workers/cpanel/dist
COPY workers/core/webide/manifest.yaml /opt/edger/core-workers/webide/manifest.yaml
COPY --from=frontend-builder /src/workers/core/webide/dist /opt/edger/core-workers/webide/dist

RUN groupadd --system --gid 10001 edger \
    && useradd --system --uid 10001 --gid 10001 --home-dir /app --shell /usr/sbin/nologin edger \
    && mkdir -p /app/workers /app/core-worker-overlays \
    && chown -R edger:edger /app \
    && chmod -R a-w /opt/edger/core-workers

ENV DENO_DIR=/tmp/deno \
    EDGER_JS_RUNTIME=process \
    EDGER_CORE_WORKER_DIR=/opt/edger/core-workers \
    EDGER_CORE_WORKER_OVERLAY_DIR=/app/core-worker-overlays \
    HOME=/tmp \
    PORT=3000 \
    RUNTIME_WORKER_DIRS=/app/workers

EXPOSE 3000
VOLUME ["/app/workers", "/app/core-worker-overlays"]
USER 10001:10001
ENTRYPOINT ["edger"]
